# IOA — Institute Outreach Automation
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control. Keep it on the user's Windows machine only.

# Telegram Bot credentials (obtain from @BotFather)
IOA_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
IOA_TELEGRAM_CHAT_ID=123456789

# Input directory containing Excel and TXT files (Windows path)
IOA_INPUT_DIRECTORY=C:\Users\USERW\Desktop\contect - Copy

# Fixed Chrome Profile 40 (DO NOT CHANGE)
IOA_CHROME_USER_DATA_DIR=C:\Users\USERW\AppData\Local\Google\Chrome\User Data
IOA_CHROME_PROFILE_DIRECTORY=Profile 40
IOA_CHROME_PROFILE_PATH=C:\Users\USERW\AppData\Local\Google\Chrome\User Data\Profile 40

# Message placeholder used in the TXT template
IOA_MESSAGE_PLACEHOLDER={{institute_name}}

# Timezone for all scheduling (Asia/Aden = UTC+3)
IOA_TIMEZONE=Asia/Aden

# Default country code for Yemen (+967) — fallback for local numbers
IOA_DEFAULT_COUNTRY_CODE=+967

# Campaign scheduling defaults
IOA_MESSAGE_INTERVAL_SECONDS=60
IOA_MAX_MESSAGES_PER_SESSION=50
IOA_SENDING_START_HOUR=9
IOA_SENDING_END_HOUR=17

# UI language: ar (Arabic) or en (English)
IOA_LANGUAGE=ar
